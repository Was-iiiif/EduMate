<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".EduMateApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.EduMate">

        <!-- Main Home Screen -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Topic Selection Screen -->
        <activity
            android:name=".ui.TopicSelectionActivity"
            android:exported="false"
            android:label="@string/title_topic_selection" />

        <!-- Teaching Session Chat Screen -->
        <activity
            android:name=".ui.SessionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_session" />

        <!-- Feedback & Evaluation Screen -->
        <activity
            android:name=".ui.FeedbackActivity"
            android:exported="false"
            android:label="@string/title_feedback" />

        <!-- History Screen -->
        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history" />

        <!-- Settings Screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- Started Service Demo (Course Requirement) -->
        <service
            android:name=".background.EduMateSyncService"
            android:exported="false" />

        <!-- Read-Only Content Provider Demo (Course Requirement) -->
        <provider
            android:name=".provider.EduMateProvider"
            android:authorities="com.edumate.app.provider"
            android:exported="false" />

    </application>

</manifest>
